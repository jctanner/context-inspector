# Required for the validated Claude Code through Vertex configuration.
CLAUDE_CODE_USE_VERTEX=1
ANTHROPIC_VERTEX_PROJECT_ID=your-google-cloud-project-id
CLOUD_ML_REGION=global

# Optional: override the host ADC file copied into the agent container.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

# Optional runtime overrides.
# AGENT_IMAGE=localhost/claude-task-runner:latest
# MITM_PROXY_IMAGE=docker.io/mitmproxy/mitmproxy:12.1.2
# CONTEXT_INSPECTOR_MODEL=claude-haiku-4-5
# CONTEXT_INSPECTOR_PORT=8765
# CONTEXT_INSPECTOR_CONTEXT_WINDOW_TOKENS=200000

# Dynamic stdio MCP experiment (new Claude sessions; edit workspace config live).
CONTEXT_INSPECTOR_MCP_DUMP_ENABLED=1

# Disposable MLflow server and Claude tracing (new sessions only).
# Database and artifacts are discarded on shutdown; no volumes are mounted.
# CONTEXT_INSPECTOR_MLFLOW_ENABLED=1
# CONTEXT_INSPECTOR_MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.0
# CONTEXT_INSPECTOR_MLFLOW_PORT=5000
# CONTEXT_INSPECTOR_MLFLOW_HOST=127.0.0.1
# For remote access explicitly bind 0.0.0.0 and add your hostname/IP below.
# Keep localhost entries for readiness. This service has no authentication.
# CONTEXT_INSPECTOR_MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,your-host:5000
# Browser POSTs also require their full origin (scheme + host + port).
# CONTEXT_INSPECTOR_MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://your-host:5000
# Disable tracing while keeping the MLflow UI running:
# CONTEXT_INSPECTOR_MLFLOW_TRACING_ENABLED=0
# CONTEXT_INSPECTOR_MLFLOW_EXPERIMENT_NAME=Claude Code
# Trace Claude and descendants to container/strace/pid.*; sensitive, unbounded logs.
# CONTEXT_INSPECTOR_STRACE_ENABLED=0

# Native OAuth harnesses (selected in Start session).
# Reuse existing Linux host CLI logins; no tokens belong in this file.
# Codex supports cli_auth_credentials_store="file" only.
# CODEX_HOME=/absolute/path/to/host/.codex
# CLAUDE_SECURESTORAGE_CONFIG_DIR=/absolute/path/to/host/credential-directory
# The Claude credential directory is mounted separately from inspector settings.
# OAuth profiles disable strace and tracing/experiment integrations themselves.

# Harness packages are installed in a cached derived AGENT_IMAGE. Refresh latest:
# .venv/bin/python -m src.runtime.harness_image --refresh
