#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
project_env="${project_dir}/.env"

if [[ ! -f ${project_env} ]]; then
    echo "ERROR: required environment file not found: ${project_env}" >&2
    echo "Create it with: cp ${project_dir}/.env.example ${project_env}" >&2
    exit 1
fi
set -a
source "${project_env}"
set +a

if [[ ! -f "${project_dir}/src/web/dist/index.html" ]]; then
    npm --prefix "${project_dir}/src/web" run build
fi

cd "${project_dir}"
python_bin="${project_dir}/.venv/bin/python"
if [[ ! -x ${python_bin} ]]; then
    echo "ERROR: project virtual environment not found: ${python_bin}" >&2
    echo "Create it with: python3 -m venv ${project_dir}/.venv" >&2
    echo "Install dependencies with: ${python_bin} -m pip install -e '${project_dir}[dev]'" >&2
    exit 1
fi
exec "${python_bin}" -m src.server
